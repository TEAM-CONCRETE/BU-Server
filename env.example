# Build-Up Backend 환경 변수 설정
# 이 파일을 .env로 복사하여 실제 값으로 채워주세요.
# cp env.example .env

# ============================================
# Spring 프로파일 설정
# ============================================
SPRING_PROFILES_ACTIVE=prod

# ============================================
# 애플리케이션 포트 (선택사항)
# ============================================
APP_PORT=8080

# ============================================
# JWT 설정
# ============================================
# JWT Secret Key (최소 256비트, 32자 이상 권장)
# 생성 방법: openssl rand -hex 32
JWT_SECRET=your-secret-key-min-256-bits-long-for-hs256-algorithm

# ============================================
# 암호화 설정
# ============================================
# AES-256 암호화 키 (32바이트 필수)
# 생성 방법: openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_secure_encryption_key

# ============================================
# 관리자 계정
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# ============================================
# 데이터베이스 설정 (MySQL)
# ============================================
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=buildup
MYSQL_USER=buildup_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_PORT=3306

# ============================================
# AWS S3 설정
# ============================================
AWS_S3_ENABLED=true
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ============================================
# AI Face Similarity API 설정 (선택사항)
# ============================================
AI_FACE_SIMILARITY_BASE_URL=http://localhost:8000
AI_FACE_SIMILARITY_API_KEY=your_face_api_key
AI_FACE_SIMILARITY_CONNECT_TIMEOUT=5000
AI_FACE_SIMILARITY_READ_TIMEOUT=10
AI_FACE_SIMILARITY_WRITE_TIMEOUT=10

# ============================================
# Docker Hub 설정 (CI/CD용)
# ============================================
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token
IMAGE_TAG=latest

