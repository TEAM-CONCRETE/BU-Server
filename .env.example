# Build-Up Backend 환경변수 템플릿
# 이 파일을 `.env`로 복사하여 실제 값을 입력하세요
# 주의: .env 파일은 .gitignore에 포함되어 Git에 커밋되지 않습니다

# ===================================
# 애플리케이션 설정
# ===================================

# Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# 애플리케이션 포트
APP_PORT=8080

# ===================================
# 데이터베이스 설정 (운영 환경)
# ===================================

# MySQL 연결 정보
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/buildup?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useUnicode=true
SPRING_DATASOURCE_USERNAME=buildup
SPRING_DATASOURCE_PASSWORD=buildup123

# ===================================
# MySQL Docker 설정 (로컬 개발)
# ===================================

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=buildup
MYSQL_USER=buildup
MYSQL_PASSWORD=buildup123
MYSQL_PORT=3306

# ===================================
# 보안 설정
# ===================================

# JWT Secret Key (운영 환경에서 반드시 변경 필요)
# 최소 64자 이상의 랜덤 문자열 사용 권장 (HS512 알고리즘)
JWT_SECRET=your-jwt-secret-key-must-be-at-least-64-characters-for-hs512-algorithm-change-this-in-production

# JWT Access Token 만료 시간 (밀리초 단위)
JWT_ACCESS_TOKEN_EXPIRATION=3600000  # 1시간 (1000 * 60 * 60)

# JWT Refresh Token 만료 시간 (밀리초 단위)
JWT_REFRESH_TOKEN_EXPIRATION=604800000  # 7일 (1000 * 60 * 60 * 24 * 7)

# 관리자 계정 (운영 환경)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ===================================
# AWS S3 설정
# ===================================

# AWS 자격 증명 (IAM 사용자)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS S3 버킷 설정
AWS_S3_BUCKET_NAME=buildup-files
AWS_S3_REGION=ap-northeast-2  # 서울 리전

# S3 경로 설정 (선택사항)
AWS_S3_BASE_PATH=uploads/

# ===================================
# 외부 API 설정
# ===================================

# FastAPI (GCP) 엔드포인트
FASTAPI_BASE_URL=https://your-fastapi-endpoint.run.app
FASTAPI_TIMEOUT=30000  # 30초 (밀리초)

# ===================================
# 로깅 설정 (선택사항)
# ===================================

# 로그 레벨 (TRACE, DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG

# ===================================
# 기타 설정
# ===================================

# 타임존
TZ=Asia/Seoul
